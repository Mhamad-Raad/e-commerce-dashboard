enum NotificationType {
  ORDER_CREATED
  REFUND_REQUESTED
}

// Push/notification-centre event kinds shown to CUSTOMERS in the mobile app
// (distinct from the staff-facing NotificationType above).
enum CustomerNotificationType {
  ORDER_PLACED         // their checkout succeeded
  ORDER_STATUS_CHANGED // an admin moved their order to a new status
  ANNOUNCEMENT         // an admin-authored broadcast/direct message
}

// Who an admin-authored Announcement goes to.
enum AnnouncementAudience {
  ALL    // every active customer (broadcast)
  SINGLE // one specific customer (direct)
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

// Why an OTP is being sent. One column lets sign-up verification and
// forgot-password reuse a single challenge table + code path.
enum OtpPurpose {
  PHONE_VERIFICATION // sign-up: confirm the WhatsApp number is real
  PASSWORD_RESET     // forgot password
}

// Store-wide activity feed shown in the dashboard navbar bell. Body text is
// localized on the client from type + meta (kept consistent with EN/AR UI).
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  meta      Json?
  // Deep-link target, e.g. "/orders/<id>" or "/refunds/<id>".
  link      String?
  // User who caused it (if any) — the client suppresses the toast for its own
  // actions while still showing them in the feed.
  actorId   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// Single-row store-wide configuration (business identity + default currency).
// Always addressed by the fixed id "singleton".
model Setting {
  id              String   @id @default("singleton")
  businessName    String?
  businessEmail   String?
  businessPhone   String?
  businessAddress String?
  defaultCurrency String   @default("IQD")
  // App version gate: clients below minAppVersion are refused (426 middleware +
  // launch check → blocking update screen); latestAppVersion only drives the
  // dismissible "update available" nudge. Store links are picked by client OS.
  minAppVersion    String?
  latestAppVersion String?
  appStoreUrl      String?
  playStoreUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Singleton config for the customer-facing AI shopping assistant. Lives dormant
// until ANTHROPIC_API_KEY is set and the app wires up the chat endpoint.
// Budgets are stored in USD cents (integer); a null limit/budget means "no cap".
model AssistantConfig {
  id       String  @id @default("singleton")
  // Master kill switch for the whole feature.
  enabled  Boolean @default(false)
  provider String  @default("anthropic")
  model    String  @default("claude-haiku-4-5")

  // Per-user message caps (null = unlimited for that window).
  maxMsgsPerMinute Int?
  maxMsgsPerHour   Int?
  maxMsgsPerDay    Int?
  maxMsgsPerWeek   Int?
  maxMsgsPerMonth  Int?

  // Per-user token caps (null = unlimited for that window).
  maxTokensPerDay   Int?
  maxTokensPerWeek  Int?
  maxTokensPerMonth Int?

  // Global spend caps in USD cents (null = no cap). Any cap hit -> auto-lock.
  budgetWeeklyCents  Int?
  budgetMonthlyCents Int?
  budgetTotalCents   Int?
  // Warn (don't lock) once spend crosses this % of a cap.
  warnThresholdPct   Int @default(80)

  // Set true when a budget cap is reached; lockedReason explains which.
  locked       Boolean @default(false)
  lockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String?
  role             Role      @default(ADMIN)
  refreshHash      String?
  // Previous hash kept briefly so concurrent tabs refreshing with the
  // just-rotated cookie don't get logged out.
  prevRefreshHash  String?
  refreshRotatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// A reusable tax + flat-fee rule the dashboard manages and assigns to stores.
// Resolved at checkout to add a labelled order-level fee (e.g. "Transportation")
// plus optional tax, instead of staff typing them.
model FeeGroup {
  id         String   @id @default(cuid())
  name       String
  // Customer-facing label for the flat fee, e.g. "Transportation", "Handling".
  label      String
  feeCents   Int      @default(0)
  // Percent of subtotal added as tax (0 = none). Stored as a whole percent.
  taxRatePct Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stores Store[]

  @@index([isActive])
}

model Store {
  id          String   @id @default(cuid())
  // Trilingual: bare field = English (main); Ar/Ckb optional, fall back to English.
  name        String
  nameAr      String?
  nameCkb     String?
  slug        String   @unique
  description String?
  descriptionAr  String?
  descriptionCkb String?
  logoUrl     String?
  bannerUrl   String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  isActive    Boolean  @default(true)
  feeGroupId  String?
  feeGroup    FeeGroup? @relation(fields: [feeGroupId], references: [id], onDelete: SetNull)
  // Default estimated-delivery window (in days) for this store's products. The
  // storefront turns these into a date range at order time (placedAt + N days).
  // A product can override them; null override -> inherit these defaults.
  minLeadDays Int      @default(3)
  maxLeadDays Int      @default(7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  featured FeaturedStore?
  homeItems HomeSectionItem[]

  @@index([isActive])
  @@index([createdAt])
}

model Category {
  id          String   @id @default(cuid())
  // Trilingual: bare field = English (main); Ar/Ckb optional, fall back to English.
  name        String   @unique
  nameAr      String?
  nameCkb     String?
  slug        String   @unique
  description String?
  descriptionAr  String?
  descriptionCkb String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  // Category-driven attribute definitions for products in this category, e.g.
  // beauty: [{key:"ingredients",label:"Ingredients",type:"textarea"},
  //          {key:"skinType",label:"Skin type",type:"multiselect",options:[...]}].
  // Future verticals (clothes: size/colour/material) need no schema change.
  attributeSchema Json   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  featured FeaturedCategory?
  homeItems HomeSectionItem[]

  @@index([isActive])
}

model Product {
  id             String    @id @default(cuid())
  // Trilingual: bare field = English (main); Ar/Ckb optional, fall back to English.
  name           String
  nameAr         String?
  nameCkb        String?
  description    String?
  descriptionAr  String?
  descriptionCkb String?
  sku            String    @unique
  priceCents     Int
  salePriceCents Int?
  currency       String    @default("IQD")
  stock          Int       @default(0)
  // Cover image (the main image shown in lists/cards). Required at the API layer
  // (kept nullable in the DB so pre-existing rows aren't invalidated).
  imageUrl       String?
  // Optional additional gallery images, ordered. The cover is NOT included here.
  images         String[]  @default([])
  // Values for this product's category attributes, keyed by attribute key
  // (e.g. {"ingredients":"Aqua, Niacinamide", "skinType":["oily","combination"]}).
  attributes     Json      @default("{}")
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive       Boolean   @default(true)
  ratingAvg      Float     @default(0)
  ratingCount    Int       @default(0)
  // Alert when stock falls to/below this level (for products sold without variants).
  lowStockThreshold Int    @default(5)
  // Per-product override of the store's estimated-delivery window (in days).
  // null on either field -> fall back to the store's default for that bound.
  minLeadDays    Int?
  maxLeadDays    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  variants       ProductVariant[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  featured       FeaturedProduct?
  stockMovements StockMovement[]
  favorites      Favorite[]
  homeItems      HomeSectionItem[]

  @@index([storeId])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String   @unique
  priceCents     Int
  salePriceCents Int?
  stock          Int      @default(0)
  imageUrl       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  lowStockThreshold Int   @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
  @@index([isActive])
}

model HeroBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model FeaturedProduct {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@index([sortOrder])
}

model FeaturedCategory {
  id         String   @id @default(cuid())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@index([sortOrder])
}

model FeaturedStore {
  id        String @id @default(cuid())
  storeId   String @unique
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

// ── Dashboard-built home layout (server-driven sections) ──────────────────────
// The mobile home is an ordered list of HomeSections. Each section's `type`
// selects a distinct design (mirrored 1:1 in the dashboard preview); its items
// reference what to show + where tapping goes. Supersedes the fixed HeroBanner/
// Featured* models above (kept until the new dashboard builder replaces them).

enum HomeSectionType {
  BANNER     // full-width promo/ad image carousel
  BLOG       // editorial posts (cards/carousel) -> article reader
  BRANDS     // row of store logos -> store page
  CATEGORIES // row/grid of categories -> filtered product list
  PRODUCTS   // product slider/grid -> product detail
}

// Where tapping a section item navigates.
enum HomeTargetType {
  NONE
  PRODUCT
  CATEGORY
  STORE
  BLOG
  URL
}

model HomeSection {
  id        String          @id @default(cuid())
  type      HomeSectionType
  position  Int             @default(0)
  isActive  Boolean         @default(true)
  // Trilingual section heading (optional — some sections show no title).
  titleEn   String?
  titleAr   String?
  titleCkb  String?
  // Type-specific display options, e.g. {"layout":"slider"|"grid","autoplay":true}.
  // Kept as JSON so new per-type options need no schema change.
  config    Json            @default("{}")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  items HomeSectionItem[]

  @@index([position])
  @@index([isActive])
}

model HomeSectionItem {
  id         String          @id @default(cuid())
  sectionId  String
  section    HomeSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  position   Int             @default(0)
  // Optional overrides; otherwise the target's own image/name is used.
  imageUrl   String?
  // Trilingual item text — bare field = English (main); Ar/Ckb fall back to it.
  label       String?  // headline / display name
  labelAr     String?
  labelCkb    String?
  subtitle    String?  // banner sub-headline
  subtitleAr  String?
  subtitleCkb String?
  badge       String?  // pill badge, e.g. "NEW ARRIVALS" / "BESTSELLER"
  badgeAr     String?
  badgeCkb    String?
  ctaLabel    String?  // banner call-to-action button text
  ctaLabelAr  String?
  ctaLabelCkb String?
  // Tap target — at most one of the relations below is set, matching targetType.
  targetType HomeTargetType  @default(NONE)
  productId  String?
  product    Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  storeId    String?
  store      Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  blogPostId String?
  blogPost   BlogPost?       @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  url        String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([sectionId])
}

// Editorial "story"/blog post surfaced by BLOG home sections and read in-app.
model BlogPost {
  id          String    @id @default(cuid())
  titleEn     String
  titleAr     String?
  titleCkb    String?
  excerptEn   String?
  excerptAr   String?
  excerptCkb  String?
  // Rich body (HTML/markdown), trilingual.
  bodyEn      String?
  bodyAr      String?
  bodyCkb     String?
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  homeItems HomeSectionItem[]

  @@index([isPublished])
  @@index([createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  // Optional + unique: dashboard-created customers still have an email, but the
  // mobile app is phone-first, so app sign-ups may omit it. Postgres allows many
  // NULLs under a unique index.
  email     String?  @unique
  name      String
  // Required for app sign-ups and dashboard create/edit, but nullable in the DB:
  // customers created before this field existed have no value. New writes always
  // set it (enforced by the register/create DTOs + dashboard form).
  gender    Gender?
  // The mobile login identifier. Stored normalized E.164 (+9647XXXXXXXXX) and
  // unique so two accounts can't claim the same WhatsApp number.
  phone     String?  @unique
  // Null for dashboard-created customers who never set an app password.
  passwordHash    String?
  // Null until a WhatsApp OTP confirms the number. Login is gated on this.
  phoneVerifiedAt DateTime?
  address   String?
  city      String?
  country   String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  // Per-customer kill switch for the AI assistant (toggled from customer detail).
  assistantEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts         Cart[]
  orders        Order[]
  addresses     Address[]
  reviews       Review[]
  favorites     Favorite[]
  conversations Conversation[]
  sessions      CustomerSession[]
  devices       CustomerDevice[]
  notifications CustomerNotification[]
  announcementRecipients AnnouncementRecipient[]

  @@index([isActive])
  @@index([createdAt])
}

// A registered push (FCM) device for a customer. The token is the FCM
// registration token; it rotates independently of the auth session (Firebase
// can refresh it any time) so it is NOT tied to a CustomerSession row — the app
// re-registers whenever the token changes and unregisters on logout. `locale`
// is the device's app language at registration, used to render the push tray
// text (title/body) server-side in the right language. One token = one row.
model CustomerDevice {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String         @unique // FCM registration token
  platform   DevicePlatform
  locale     String         @default("en") // en | ar | ckb — for push text
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([customerId])
}

// A customer-facing notification, persisted so the in-app notification centre
// shows history even if the push was never delivered (offline / permission
// denied). Like the admin Notification, it stores only `type` + structured
// `data` — the human text is rendered CLIENT-side from the app's current
// language (trilingual), so the same row reads correctly in EN/AR/CKB. The push
// tray text is rendered separately server-side per device locale at send time.
model CustomerNotification {
  id         String                   @id @default(cuid())
  customerId String
  customer   Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       CustomerNotificationType
  data       Json // e.g. { orderId, number, status }
  isRead     Boolean                  @default(false)
  createdAt  DateTime                 @default(now())

  // Set for ANNOUNCEMENT rows: the authored content lives once on Announcement
  // and is fanned out to one row per recipient. Deleting the announcement
  // cascades these rows out of every customer's feed.
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([customerId, isRead])
}

// An admin-authored notification. The content is stored ONCE here (trilingual
// title/body + image + a single tappable target, reusing HomeTargetType) and
// fanned out to a CustomerNotification per recipient on send. Target ids are
// plain columns (no FK) resolved at read time, so deleting a linked product
// just leaves a dead link rather than nuking history.
model Announcement {
  id         String              @id @default(cuid())
  titleEn    String
  titleAr    String?
  titleCkb   String?
  bodyEn     String
  bodyAr     String?
  bodyCkb    String?
  imageUrl   String?
  targetType HomeTargetType      @default(NONE)
  targetId   String? // product/category/store/blog id, by targetType
  url        String? // when targetType = URL
  audience   AnnouncementAudience @default(ALL)
  // For audience = SINGLE: the explicitly chosen recipients (one or more). Empty
  // for ALL broadcasts. recipientCount snapshots how many it was sent to.
  recipients     AnnouncementRecipient[]
  recipientCount Int                     @default(0)
  createdAt      DateTime                @default(now())

  notifications CustomerNotification[]

  @@index([createdAt])
}

// Join: which specific customers an Announcement targeted (audience = SINGLE).
// Broadcasts (ALL) store no rows here.
model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([announcementId, customerId])
  @@index([customerId])
}

// One pending/used OTP code for a phone number. Single table for every
// OtpPurpose. With Twilio Verify (v1) Twilio holds the actual code, so codeHash
// stays NULL — we keep the row for resend throttling, attempt caps, purpose +
// customer binding, and audit. The future self-managed Meta-direct provider
// generates the code itself and stores its sha-256 in codeHash; no schema change.
model OtpChallenge {
  id          String     @id @default(cuid())
  phone       String     // normalized E.164 destination
  purpose     OtpPurpose
  customerId  String?    // null during sign-up (account may not exist yet)
  codeHash    String?    // NULL under Twilio Verify; sha-256 under self-managed
  providerRef String?    // Twilio Verify SID — correlation + audit
  expiresAt   DateTime
  consumedAt  DateTime?  // single-use: set on the successful verify
  attempts    Int        @default(0) // wrong-code tries; lock after a cap
  resendCount Int        @default(0) // resends issued for this challenge
  lastSentAt  DateTime   @default(now()) // drives the resend cooldown
  createdAt   DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

// A mobile refresh-token session. Unlike the admin User (one refreshHash column,
// cookie-based, single device), the app needs multi-device sessions with
// rotation + reuse detection — so each refresh lives as its own row.
//
// Rotation: on every /refresh the presented row is revoked and a new row is
// created sharing the same familyId. Reuse detection: presenting a token whose
// row is ALREADY revoked (replay/theft) revokes the whole family → forced
// re-login. tokenHash is the sha-256 of the raw refresh token (never stored raw).
model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  familyId   String    // stable across rotations of one login session
  tokenHash  String    @unique // sha-256 of the current refresh token
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  rotatedAt  DateTime  @default(now())
  revokedAt  DateTime? // set when rotated out or explicitly revoked
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([familyId])
}

// A customer's AI-assistant chat thread. Created by the chat endpoint; viewable
// read-only by admins on the customer detail page.
//
// A thread belongs EITHER to a signed-in customer (customerId set) OR to an
// unauthenticated guest trying the assistant before signing up (guestDeviceId
// set, customerId null). Exactly one identifies the owner; the guest path is
// capped to a few free messages server-side (see chatForGuest).
model Conversation {
  id            String    @id @default(cuid())
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestDeviceId String? // app-generated device id for unauthenticated guest trials
  title         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages Message[]

  @@index([customerId])
  @@index([guestDeviceId])
  @@index([updatedAt])
}

// One turn in a conversation. Usage/cost fields are set on assistant turns only.
// costMicros = micro-USD (1e-6 USD; 1 cent = 10_000) to avoid sub-cent rounding
// loss when summing many cheap messages for budget enforcement.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'user' | 'assistant'
  content        String
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  costMicros     Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// A customer's saved/wishlisted product. Populated by the mobile app once it
// ships a "favorite" action; surfaced read-only on the customer detail page.
model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  title      String?
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([productId])
  @@index([isApproved])
}

model Address {
  id              String      @id @default(cuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label           String?
  governorate     Governorate
  city            City
  district        String?
  street          String?
  nearestLandmark String?
  phone           String?
  isDefault       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
}

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  type             DiscountType
  value            Int
  minSubtotalCents Int          @default(0)
  maxRedemptions   Int?
  redeemedCount    Int          @default(0)
  startsAt         DateTime?
  expiresAt        DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  carts Cart[]

  @@index([isActive])
}

model Cart {
  id            String     @id @default(cuid())
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status        CartStatus @default(OPEN)
  couponId      String?
  coupon        Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountCents Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items CartItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model CartItem {
  id          String          @id @default(cuid())
  cartId      String
  cart        Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName String?
  quantity    Int
  priceCents  Int

  @@unique([cartId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id             String      @id @default(cuid())
  number         String      @unique
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  subtotalCents  Int
  discountCents  Int         @default(0)
  couponCode     String?
  taxCents       Int         @default(0)
  shippingCents  Int         @default(0)
  // Auto-resolved fee-group charge (e.g. transportation) + its display label.
  feesCents      Int         @default(0)
  feesLabel      String?
  totalCents     Int
  currency       String      @default("IQD")
  notes          String?
  trackingNumber String?
  // Whether this order currently holds reserved stock. Set true once stock is
  // decremented; flipped false when cancelled/refunded returns it. Drives safe
  // re-reservation if the order is later re-opened.
  stockReserved  Boolean     @default(false)
  status         OrderStatus @default(PENDING)
  placedAt       DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Shipping address snapshot (copied from a customer Address at order time so
  // historical orders stay correct if the address is later edited/deleted).
  shipName        String?
  shipPhone       String?
  shipGovernorate Governorate?
  shipCity        City?
  shipDistrict    String?
  shipStreet      String?
  shipLandmark    String?

  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  events         OrderEvent[]
  refunds        Refund[]

  @@index([customerId])
  @@index([status])
  @@index([placedAt])
}

model Refund {
  id          String       @id @default(cuid())
  number      String       @unique
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      RefundStatus @default(REQUESTED)
  reason      RefundReason
  note        String?
  amountCents Int
  currency    String       @default("IQD")
  // Whether completing this refund returns the items to inventory.
  restock     Boolean      @default(true)
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items RefundItem[]

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model RefundItem {
  id          String  @id @default(cuid())
  refundId    String
  refund      Refund  @relation(fields: [refundId], references: [id], onDelete: Cascade)
  // Plain reference to the source OrderItem (snapshot below keeps it correct even
  // if the order is later edited); not an FK so refund history is independent.
  orderItemId String
  productId   String
  variantId   String?
  name        String
  variantName String?
  quantity    Int
  priceCents  Int

  @@index([refundId])
}

model OrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  // Structured detail rendered (and localized) by the dashboard, e.g.
  // { from, to } for a status change or { amountCents, method } for a payment.
  meta      Json?
  createdAt DateTime       @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int
  reference   String?
  note        String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

model StockMovement {
  id             String              @id @default(cuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta          Int
  resultingStock Int
  reason         StockMovementReason
  note           String?
  // Kept (SetNull) when the order is deleted so the ledger stays auditable.
  orderId        String?
  order          Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@index([createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName String?
  name        String
  sku         String
  quantity    Int
  priceCents  Int

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}
