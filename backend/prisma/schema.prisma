// Single-row store-wide configuration (business identity + default currency).
// Always addressed by the fixed id "singleton".
model Setting {
  id              String   @id @default("singleton")
  businessName    String?
  businessEmail   String?
  businessPhone   String?
  businessAddress String?
  defaultCurrency String   @default("IQD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(ADMIN)
  refreshHash  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A reusable tax + flat-fee rule the dashboard manages and assigns to stores
// and/or brands. Resolved at checkout to add a labelled order-level fee
// (e.g. "Transportation") plus optional tax, instead of staff typing them.
model FeeGroup {
  id         String   @id @default(cuid())
  name       String
  // Customer-facing label for the flat fee, e.g. "Transportation", "Handling".
  label      String
  feeCents   Int      @default(0)
  // Percent of subtotal added as tax (0 = none). Stored as a whole percent.
  taxRatePct Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stores Store[]
  brands Brand[]

  @@index([isActive])
}

model Store {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  bannerUrl   String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  isActive    Boolean  @default(true)
  feeGroupId  String?
  feeGroup    FeeGroup? @relation(fields: [feeGroupId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  featured FeaturedStore?

  @@index([isActive])
  @@index([createdAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  featured FeaturedCategory?

  @@index([isActive])
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  feeGroupId  String?
  feeGroup    FeeGroup? @relation(fields: [feeGroupId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model Product {
  id             String    @id @default(cuid())
  name           String
  description    String?
  sku            String    @unique
  priceCents     Int
  salePriceCents Int?
  currency       String    @default("IQD")
  stock          Int       @default(0)
  imageUrl       String?
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId        String?
  brand          Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  isActive       Boolean   @default(true)
  ratingAvg      Float     @default(0)
  ratingCount    Int       @default(0)
  // Alert when stock falls to/below this level (for products sold without variants).
  lowStockThreshold Int    @default(5)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  variants       ProductVariant[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  featured       FeaturedProduct?
  stockMovements StockMovement[]

  @@index([storeId])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([createdAt])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String   @unique
  priceCents     Int
  salePriceCents Int?
  stock          Int      @default(0)
  imageUrl       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  lowStockThreshold Int   @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
  @@index([isActive])
}

model HeroBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model FeaturedProduct {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@index([sortOrder])
}

model FeaturedCategory {
  id         String   @id @default(cuid())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@index([sortOrder])
}

model FeaturedStore {
  id        String @id @default(cuid())
  storeId   String @unique
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  address   String?
  city      String?
  country   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts     Cart[]
  orders    Order[]
  addresses Address[]
  reviews   Review[]

  @@index([isActive])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  title      String?
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([productId])
  @@index([isApproved])
}

model Address {
  id              String      @id @default(cuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label           String?
  governorate     Governorate
  city            City
  district        String?
  street          String?
  nearestLandmark String?
  phone           String?
  isDefault       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
}

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  type             DiscountType
  value            Int
  minSubtotalCents Int          @default(0)
  maxRedemptions   Int?
  redeemedCount    Int          @default(0)
  startsAt         DateTime?
  expiresAt        DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  carts Cart[]

  @@index([isActive])
}

model Cart {
  id            String     @id @default(cuid())
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status        CartStatus @default(OPEN)
  couponId      String?
  coupon        Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountCents Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items CartItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model CartItem {
  id          String          @id @default(cuid())
  cartId      String
  cart        Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName String?
  quantity    Int
  priceCents  Int

  @@unique([cartId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id             String      @id @default(cuid())
  number         String      @unique
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  subtotalCents  Int
  discountCents  Int         @default(0)
  couponCode     String?
  taxCents       Int         @default(0)
  shippingCents  Int         @default(0)
  // Auto-resolved fee-group charge (e.g. transportation) + its display label.
  feesCents      Int         @default(0)
  feesLabel      String?
  totalCents     Int
  currency       String      @default("IQD")
  notes          String?
  trackingNumber String?
  status         OrderStatus @default(PENDING)
  placedAt       DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Shipping address snapshot (copied from a customer Address at order time so
  // historical orders stay correct if the address is later edited/deleted).
  shipName        String?
  shipPhone       String?
  shipGovernorate Governorate?
  shipCity        City?
  shipDistrict    String?
  shipStreet      String?
  shipLandmark    String?

  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  events         OrderEvent[]

  @@index([customerId])
  @@index([status])
  @@index([placedAt])
}

model OrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  // Structured detail rendered (and localized) by the dashboard, e.g.
  // { from, to } for a status change or { amountCents, method } for a payment.
  meta      Json?
  createdAt DateTime       @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int
  reference   String?
  note        String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

model StockMovement {
  id             String              @id @default(cuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta          Int
  resultingStock Int
  reason         StockMovementReason
  note           String?
  // Kept (SetNull) when the order is deleted so the ledger stays auditable.
  orderId        String?
  order          Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@index([createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName String?
  name        String
  sku         String
  quantity    Int
  priceCents  Int

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}
