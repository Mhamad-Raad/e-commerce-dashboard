  BAGHDAD
  ABU_GHRAIB
  MAHMUDIYAH
  TARMIYAH
  SADR_CITY
  // Basra
  BASRA
  ZUBAIR
  ABU_AL_KHASIB
  QURNA
  FAW
  // Nineveh
  MOSUL
  TAL_AFAR
  SINJAR
  HAMDANIYA
  SHEIKHAN
  // Erbil
  ERBIL
  SHAQLAWA
  KOYA
  SORAN
  CHOMAN
  // Sulaymaniyah
  SULAYMANIYAH
  RANIA
  CHAMCHAMAL
  KALAR
  DUKAN
  // Duhok
  DUHOK
  ZAKHO
  AMEDI
  SEMEL
  AKRE
  // Kirkuk
  KIRKUK
  HAWIJA
  DAQUQ
  DIBIS
  // Najaf
  NAJAF
  KUFA
  MISHKHAB
  MANATHERA
  // Karbala
  KARBALA
  AIN_AL_TAMR
  HINDIYA
  // Babylon
  HILLAH
  MUSAYYIB
  MAHAWIL
  HASHIMIYA
