generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum CartStatus {
  OPEN
  CHECKED_OUT
  ABANDONED
}

// Unified order + fulfilment lifecycle (no separate delivery status).
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  TRANSFER
  CARD
  WALLET
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Entries in an order's append-only audit timeline.
enum OrderEventType {
  CREATED
  STATUS_CHANGED
  STOCK_RESTORED
  TRACKING_UPDATED
  NOTE_UPDATED
  PAYMENT_RECORDED
  PAYMENT_UPDATED
  PAYMENT_REMOVED
}

// Why a stock level changed. ORDER decrements on order placement;
// ORDER_CANCELLED reverses that when an order is cancelled/refunded/deleted;
// RESTOCK is a positive supplier top-up; ADJUSTMENT is a manual correction.
enum StockMovementReason {
  ORDER
  ORDER_CANCELLED
  RESTOCK
  ADJUSTMENT
}

// Iraq's 19 governorates.
enum Governorate {
  BAGHDAD
  BASRA
  NINEVEH
  ERBIL
  SULAYMANIYAH
  DUHOK
  KIRKUK
  NAJAF
  KARBALA
  BABYLON
  WASIT
  MAYSAN
  DHI_QAR
  MUTHANNA
  QADISIYYAH
  DIYALA
  ANBAR
  SALADIN
  HALABJA
}

