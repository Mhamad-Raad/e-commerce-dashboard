generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum Gender {
  FEMALE
  MALE
}

enum CartStatus {
  OPEN
  CHECKED_OUT
  ABANDONED
}

// Unified order + fulfilment lifecycle (no separate delivery status).
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  TRANSFER
  CARD
  WALLET
  ZAIN_CASH
  FIB
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Entries in an order's append-only audit timeline.
enum OrderEventType {
  CREATED
  STATUS_CHANGED
  STOCK_RESERVED
  STOCK_RESTORED
  TRACKING_UPDATED
  NOTE_UPDATED
  PAYMENT_RECORDED
  PAYMENT_UPDATED
  PAYMENT_REMOVED
  REFUND_REQUESTED
  REFUND_COMPLETED
}

// Why a stock level changed. ORDER decrements on order placement;
// ORDER_CANCELLED reverses that when an order is cancelled/refunded/deleted;
// RETURN puts goods back when a refund is completed with restock;
// RESTOCK is a positive supplier top-up; ADJUSTMENT is a manual correction.
enum StockMovementReason {
  ORDER
  ORDER_CANCELLED
  RETURN
  RESTOCK
  ADJUSTMENT
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum RefundReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  ARRIVED_LATE
  CHANGED_MIND
  OTHER
}

