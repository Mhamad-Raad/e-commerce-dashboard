DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_dashboard?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"

JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="7d"

CORS_ORIGIN="http://localhost:5173"
PORT=3000

# --- Mobile customer auth (phone + password + WhatsApp OTP) ---
# Separate secret from the admin JWT so customer and admin tokens never cross over.
CUSTOMER_JWT_ACCESS_SECRET="change-me-customer-access-secret"
CUSTOMER_ACCESS_TTL="15m"
CUSTOMER_REFRESH_TTL_DAYS=30

# WhatsApp OTP via Twilio Verify. Leave unset in local dev — OTP then falls back
# to LogOtpProvider, which prints the code to the server console (no Twilio needed).
# Cost roadmap: switch to Meta WhatsApp Cloud API direct later (~15x cheaper per
# message) by adding a MetaCloudOtpProvider — see otp-provider.interface.ts.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"

# --- Production only (leave unset in local dev) ---
# NODE_ENV=production            # flips refresh cookie to Secure; API MUST be HTTPS
# COOKIE_SAMESITE=none           # cross-site SPA+API (Pages + Cloud Run). 'lax' if same domain
# TRUST_PROXY=true               # set when behind a proxy/LB (Cloud Run, Render, nginx)
# CORS_ORIGIN=https://<your-frontend>.pages.dev   # the deployed SPA origin

# --- Image upload / Cloudflare R2 (added when the R2 bucket is ready) ---
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=ecommerce-images
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Push notifications / Firebase Cloud Messaging (added when FCM is ready) ---
# Service-account credentials from the Firebase console:
# Project settings → Service accounts → Generate new private key (JSON).
# Leave unset in local dev — push is then DORMANT (FcmService no-ops, logs a warning).
# The private key spans multiple lines; paste it as ONE line with literal \n escapes.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
