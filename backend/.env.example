# ============================================================================
# Backend environment. Copy to .env and fill in real values.
# Every variable the code reads is documented here; optional groups say what
# happens when they are left unset.
# ============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_dashboard?schema=public"

# --- Admin (dashboard) auth ---------------------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="7d"

# Seed credentials for the first admin user (prisma/seed.ts).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"

# --- Mobile customer auth (phone + password + WhatsApp OTP) ------------------
# Separate secret from the admin JWT so customer and admin tokens never cross over.
CUSTOMER_JWT_ACCESS_SECRET="change-me-customer-access-secret"
CUSTOMER_ACCESS_TTL="15m"
CUSTOMER_REFRESH_TTL_DAYS=30

# --- HTTP server --------------------------------------------------------------
PORT=3000
# Comma-separated allowed origins for CORS (the deployed SPA origin in prod).
CORS_ORIGIN="http://localhost:5173"

# --- Proxy / cookies (production deploys) ------------------------------------
# TRUST_PROXY=true — REQUIRED when behind a proxy/LB (Render, Cloud Run, nginx):
# without it rate limiting sees the proxy IP for every client; with it set while
# NOT behind a proxy, clients can spoof X-Forwarded-For.
# TRUST_PROXY=true

# Admin refresh-cookie flags. Cross-site deploys (frontend and API on different
# domains) need SameSite=None, which browsers only accept with Secure — set BOTH:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# --- AI customer assistant ----------------------------------------------------
# Claude API key. Leave unset — the assistant stays DORMANT (chat returns 503).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- WhatsApp OTP via Twilio Verify -------------------------------------------
# Leave unset in local dev — OTP falls back to LogOtpProvider, which prints the
# code to the server console (no Twilio needed).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Push notifications / Firebase Cloud Messaging ----------------------------
# Service-account credentials from the Firebase console:
# Project settings → Service accounts → Generate new private key (JSON).
# Leave unset in local dev — push is DORMANT (FcmService no-ops, logs a warning).
# The private key spans multiple lines in the JSON; it MUST be pasted as ONE
# line with literal \n escapes, wrapped in quotes.
# FIREBASE_PROJECT_ID=my-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# --- Image uploads / Cloudflare R2 ---------------------------------------------
# Leave unset in local dev — upload endpoints then return 503.
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=ecommerce-images
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
