DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_dashboard?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"

JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="7d"

CORS_ORIGIN="http://localhost:5173"
PORT=3000

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"

# --- Production only (leave unset in local dev) ---
# NODE_ENV=production            # flips refresh cookie to Secure; API MUST be HTTPS
# COOKIE_SAMESITE=none           # cross-site SPA+API (Pages + Cloud Run). 'lax' if same domain
# TRUST_PROXY=true               # set when behind a proxy/LB (Cloud Run, Render, nginx)
# CORS_ORIGIN=https://<your-frontend>.pages.dev   # the deployed SPA origin

# --- Image upload / Cloudflare R2 (added when the R2 bucket is ready) ---
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=ecommerce-images
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
